# Keep the build context small and free of host-specific or secret files.
# node_modules from a Mac checkout would overwrite the Linux build's own install.
.git
.env
.env.*
# e.g. packaging/mcp/.env, the connector's secrets
**/.env
**/.env.*
secrets/
# The agent socket directory (docker-compose.yml mounts it at /agent)
agent/
.claude/
.venv/
**/__pycache__/
.pytest_cache/
graphify-out/
test-results/
playwright-report/
web/node_modules/
web/dist/
web/docs/
web/*.tsbuildinfo
# Tests are not needed to build the image
tests/
web/src/core/__tests__/
# The desktop app is built on the laptop, not in the server image (its Rust output is over 1 GB)
desktop/
