# Runs packaging/docker/update.sh once; started by workbench-update.timer.
# @USER@ and @DIR@ are filled in at install time (see docs/setup.md, "Automatic Updates").
[Unit]
Description=Update the Workbench server to the latest release
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
ExecStart=@DIR@/packaging/docker/update.sh
