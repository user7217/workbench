# Copy to .env next to compose.yml (`chmod 600 .env`); .env is never committed.
# docs/web-connector.md explains each value.

# Public origin of the connector (scheme and host only). The claude.ai connector URL is this
# plus /mcp, and the GitHub OAuth app's callback URL is this plus /auth/callback.
WORKBENCH_MCP_PUBLIC_URL=https://mcp.example.com

# GitHub OAuth app (github.com > Settings > Developer settings > OAuth Apps)
WORKBENCH_MCP_GITHUB_CLIENT_ID=
WORKBENCH_MCP_GITHUB_CLIENT_SECRET=

# The one GitHub account allowed to sign in: its numeric id, the `id` field of
# https://api.github.com/users/<login> (not the login, which can be renamed and reused)
WORKBENCH_MCP_ALLOWED_GITHUB_ID=

# Signs the tokens issued to claude.ai and encrypts the stored OAuth state; at least 32
# characters. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
WORKBENCH_MCP_SECRET_KEY=

# Host directory holding the dashboard's agent.sock (the same directory as WORKBENCH_AGENT_DIR
# in the dashboard's .env); mounted read-only at /agent
WORKBENCH_AGENT_DIR=/srv/workbench-agent

# Optional: comma-separated redirect URIs that clients may use (default: claude.ai's and
# claude.com's https://.../api/mcp/auth_callback)
# WORKBENCH_MCP_ALLOWED_REDIRECT_URIS=
