{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench",
  "version": "0.1.0",
  "identifier": "io.github.user7217.workbench",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Workbench dashboard on this computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/workbench/": "workbench/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
