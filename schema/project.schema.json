      "title": "Topics",
      "type": "array"
    },
    "under": {
      "anyOf": [
        {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Under"
    },
    "updated": {
      "title": "Updated",
      "type": "string"
    },
    "uses_phases": {
      "default": true,
      "title": "Uses Phases",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "status",
    "updated"
  ],
  "title": "Project",
  "type": "object"
