{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "title": "Items",
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 1000,
          "title": "Notes",
          "type": "string"
        },
        "refs": {
          "items": {
            "maxLength": 64,
            "minLength": 7,
            "pattern": "^[0-9a-f]{7,64}$",
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "status": {
          "default": "not_started",
          "enum": [
            "not_started",
            "in_progress",
            "done",
            "parked"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 300,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Component",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "url": {
          "maxLength": 500,
          "minLength": 9,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "Link",
      "type": "object"
    },
    "Phase": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 1000,
          "title": "Notes",
          "type": "string"
        },
        "status": {
          "default": "not_started",
          "enum": [
            "not_started",
            "in_progress",
            "done",
            "parked"
          ],
          "title": "Status",
          "type": "string"
        },
        "subtopics": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Subtopics",
          "type": "array"
        },
        "summary": {
          "default": "",
          "maxLength": 300,
          "title": "Summary",
          "type": "string"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Phase",
      "type": "object"
    },
    "ProjectRepo": {
      "additionalProperties": false,
      "properties": {
        "github": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "root_commit": {
          "maxLength": 64,
          "minLength": 7,
          "pattern": "^[0-9a-f]{7,64}$",
          "title": "Root Commit",
          "type": "string"
        }
      },
      "required": [
        "root_commit",
        "name"
      ],
      "title": "ProjectRepo",
      "type": "object"
    },
    "Suggestion": {
      "additionalProperties": false,
      "description": "A suggested next step waiting in the project's inbox: Keep adds it to the tree, Dismiss drops it.",
      "properties": {
        "added": {
          "title": "Added",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 300,
          "title": "Summary",
          "type": "string"
        },
        "under": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Under"
        }
      },
      "required": [
        "id",
        "name",
        "added"
      ],
      "title": "Suggestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "default": "",
      "maxLength": 500,
      "title": "Description",
      "type": "string"
    },
    "id": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "origin": {
      "default": "manual",
      "enum": [
        "manual",
        "agent",
        "discovered"
      ],
      "title": "Origin",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/Phase"
      },
      "title": "Phases",
      "type": "array"
    },
    "repos": {
      "items": {
        "$ref": "#/$defs/ProjectRepo"
      },
      "title": "Repos",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
